manifest {
    name = 'gatk-gcnv-cohort-creation'
    description = 'BED processing and annotation for GATK gCNV projects'
    version = '0.1.0'
}

params {
    gatk_container = 'docker://broadinstitute/gatk:4.7.0.0'
    process_cpus = 4
    process_memory = '15 GB'
    process_time = '24h'
    workflow_cpus = 4
    workflow_memory = '15 GB'
    bed_analysis_cpus = 4
    bed_analysis_memory = '15 GB'
    bed_analysis_time = '24h'
    bed_analysis_max_forks = 1
    sample_qc_cpus = 4
    sample_qc_memory = '15 GB'
    sample_qc_time = '24h'
    sample_qc_max_forks = 1
    cohort_model_cpus = 4
    cohort_model_memory = '15 GB'
    cohort_model_time = '72h'
    cohort_model_max_forks = 1
    // Defaults for direct Nextflow runs; the app overrides these from its resource snapshot.
    annotate_intervals_cpus = 1
    annotate_intervals_memory = '2 GB'
    annotate_intervals_time = '24h'
    annotate_intervals_max_forks = 1
    bed_to_interval_list_cpus = 1
    bed_to_interval_list_memory = '2 GB'
    bed_to_interval_list_time = '24h'
    bed_to_interval_list_max_forks = 1
    collect_hs_metrics_cpus = 1
    collect_hs_metrics_memory = '4 GB'
    collect_hs_metrics_time = '24h'
    collect_hs_metrics_max_forks = 1
    collect_read_counts_cpus = 1
    collect_read_counts_memory = '4 GB'
    collect_read_counts_time = '24h'
    collect_read_counts_max_forks = 1
    determine_germline_contig_ploidy_cpus = 2
    determine_germline_contig_ploidy_memory = '8 GB'
    determine_germline_contig_ploidy_time = '72h'
    determine_germline_contig_ploidy_max_forks = 1
    filter_intervals_cpus = 1
    filter_intervals_memory = '4 GB'
    filter_intervals_time = '24h'
    filter_intervals_max_forks = 1
    flag_stat_cpus = 1
    flag_stat_memory = '1 GB'
    flag_stat_time = '24h'
    flag_stat_max_forks = 1
    gatk_version_cpus = 1
    gatk_version_memory = '1 GB'
    gatk_version_time = '24h'
    gatk_version_max_forks = 1
    germline_cnv_caller_cpus = 2
    germline_cnv_caller_memory = '8 GB'
    germline_cnv_caller_time = '72h'
    germline_cnv_caller_max_forks = 1
    index_feature_file_cpus = 1
    index_feature_file_memory = '2 GB'
    index_feature_file_time = '24h'
    index_feature_file_max_forks = 1
    postprocess_germline_cnv_calls_cpus = 1
    postprocess_germline_cnv_calls_memory = '4 GB'
    postprocess_germline_cnv_calls_time = '72h'
    postprocess_germline_cnv_calls_max_forks = 1
    preprocess_intervals_cpus = 1
    preprocess_intervals_memory = '4 GB'
    preprocess_intervals_time = '24h'
    preprocess_intervals_max_forks = 1
    validate_sam_file_cpus = 1
    validate_sam_file_memory = '2 GB'
    validate_sam_file_time = '24h'
    validate_sam_file_max_forks = 1
}

profiles {
    local {
        process {
            executor = 'local'
        }
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.cacheDir = System.getenv('GATK_GCNV_APPTAINER_CACHE') ?: "${System.getenv('HOME')}/.cache/apptainer"
        docker.enabled = false
    }
}

workDir = System.getenv('GATK_GCNV_NEXTFLOW_WORK') ?: './work'
process.errorStrategy = 'terminate'
timeline.enabled = true
report.enabled = true
trace.enabled = true
